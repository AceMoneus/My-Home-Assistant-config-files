# Influx hourly export — rolling 1 h statistics (power only; climate via UI helpers mt71–mt74)
- platform: statistics
  name: influx_stats_total_power
  unique_id: influx_stats_total_power
  entity_id: sensor.slimmelezer_momentary_active_import
  state_characteristic: mean
  max_age:
    hours: 1
  precision: 3

- platform: statistics
  name: influx_stats_total_power_min
  unique_id: influx_stats_total_power_min
  entity_id: sensor.slimmelezer_momentary_active_import
  state_characteristic: value_min
  max_age:
    hours: 1
  precision: 3

